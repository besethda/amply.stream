# Copy to .env.local and fill in. .env.local is gitignored.
#
# NOTE ON SECRECY
# Neither value below is actually a secret:
#   - The OAuth client ID is public by design. With PKCE there is no client
#     secret, and this value ships in the deploy site's browser source.
#   - The DNS TXT record is published in public DNS; anyone can query it.
# They live here for convenience, not confidentiality. If a genuine secret ever
# appears in this project, that is a signal something has gone wrong with the
# architecture — Amply is not supposed to hold credentials.

# From Cloudflare dashboard → Manage Account → OAuth clients
AMPLY_OAUTH_CLIENT_ID=

# Must match a registered redirect URI exactly — scheme, host, port, path,
# trailing slash. A mismatch fails with an unhelpful invalid_grant.
AMPLY_OAUTH_REDIRECT_URI=https://amply.stream/oauth/callback
AMPLY_OAUTH_REDIRECT_URI_DEV=http://localhost:8788/oauth/callback

# Cloudflare OAuth endpoints
AMPLY_OAUTH_AUTH_URL=https://dash.cloudflare.com/oauth2/auth
AMPLY_OAUTH_TOKEN_URL=https://dash.cloudflare.com/oauth2/token

# Scopes requested at authorization time (space-separated). These are the exact
# ids granted to the client — read off Manage Account → OAuth clients, not
# inferred from the checkbox labels, which do not match.
AMPLY_OAUTH_SCOPES=account-settings.read workers-scripts.write workers-scripts.bind workers-kv-storage.write workers-r2.write

# Domain verification TXT record for amply.stream.
# This value must be PUBLISHED IN DNS to take effect — storing it here does nothing.
AMPLY_DOMAIN_VERIFY_TXT=
